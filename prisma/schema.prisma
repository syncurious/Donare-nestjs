// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  fullName       String
  city           String
  role           String
  phone          String?
  profilePicture String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  preferences    UserPreferences?
  preferencesId  String?
  donations      Donations[]
  Volunteers     Volunteers?
  HelpRequests    HelpRequests[]
  Causes          Causes[]
}

model UserPreferences {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastZakatDate             DateTime
  receiveZakatRemainder     Boolean
  stayUpdatedOnNewCampaigns Boolean
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Donations {
  id           String       @id @default(uuid())
  userId       String
  user         Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int?
  donationType DonationType
  description  String?

  // Donation in kind fields
  isInKind      Boolean @default(false)
  itemName      String?
  itemImage     String?
  donorName     String?
  donorPhone    String?
  pickupAddress String?

  // Zakat specific fields
  zakatYear              Int?
  zakatCalculationMethod String? // "GOLD", "SILVER", "CASH", "INVESTMENTS", etc.
  zakatAssetsValue       Int?

  // Fitrah specific fields
  fitrahYear              Int?
  fitrahCalculationMethod String? // "DATES", "WHEAT", "BARLEY", "RAISINS", "CASH"
  fitrahAmount            Int?

  // Transaction details
  transactionId String?
  paymentMethod String?
  paymentStatus PaymentStatus  @default(COMPLETED)
  status        DonationStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DonationType {
  ZAKAT
  SADAQAH
  FITRAH
  CAMPAIGN
  OTHER
}

enum DonationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  NOT_AVAILABLE
}

model Volunteers {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Status   @default(PENDING)
  fullName  String
  phone     String
  email     String
  skills    String
  onWeekDays AvailabilityStatus
  onWeekEnds AvailabilityStatus
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HelpRequests {
  id        String   @id @default(uuid())
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Status   @default(PENDING)
  message   String
  fullName  String
  phone     String?
  address   String?
  city      String?
  zipCode   String?
  country   String?
  description String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
}

model Causes {
  id        String   @id @default(uuid())
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  description String
  media     String?
  mediaType MediaType
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}